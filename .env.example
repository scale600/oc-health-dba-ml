# Copy to `.env` and fill in real values. `.env` is git-ignored.
# This file contains NO secrets — only non-secret placeholders.

# --- Azure (fill from `az account show` / portal) ---
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_SQL_SERVER=oc-health-dba-ml.database.windows.net
AZURE_SQL_DB=ocbh_provider
# Leave AZURE_SQL_USER empty to use Entra ID (managed identity / `az login`).
# Only set for local dev with a SQL-auth account (NOT used in prod).
AZURE_SQL_USER=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=raw-provider-json

# --- Upstream data source (public, no auth key) ---
OC_BHP_API_BASE=https://bhpproviderdirectory.ochca.com/api/v1/

# --- Geocoding (US Census Geocoder is keyless) ---
GEOCODER=us-census
GEOCODE_CACHE_DB=geocode_cache.sqlite

# --- MLflow (local tracking during dev) ---
MLFLOW_TRACKING_URI=file://./mlruns

# --- Cloudflare Pages ---
CLOUDFLARE_PROJECT_NAME=oc-health-dba-ml
DOMAIN=oc-health-dba-ml.techcloudup.com
